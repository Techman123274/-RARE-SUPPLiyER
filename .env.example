# Copy to .env.local — never commit real keys.
# On Vercel, add the same names in Project Settings → Environment Variables.

# Public Supabase client (safe for the browser). Anon / publishable key only.
# This is a Next.js app — do not use VITE_ prefixes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public website origin used in password-reset and signup emails.
# Must match a Redirect URL in Supabase → Authentication → URL Configuration.
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production example:
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Never put any of these in this app or in committed files:
# - SUPABASE_SERVICE_ROLE_KEY
# - payment secret keys
# - webhook secrets
# - database passwords
